{
  "name": "@beidawuli/antigravity-plugin-manager",
  "version": "2.3.0",
  "description": "Interactive CLI plugin manager for the antigravity-cli ecosystem. 157 quality-audited agent skills across 16 categories.",
  "main": "src/ag-plugin-v2.js",
  "bin": {
    "ag-plugin": "src/ag-plugin-v2.js"
  },
  "scripts": {
    "test": "vitest run",
    "validate": "node scripts/validate-plugin.js",
    "registry": "node scripts/update-registry.js",
    "new-skill": "node scripts/create-skill.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Safeter/antigravity-plugin-manager.git"
  },
  "keywords": [
    "antigravity",
    "antigravity-cli",
    "agent-skills",
    "mcp",
    "mcp-server",
    "llm-agent",
    "interactive-cli",
    "plugin-manager"
  ],
  "author": "AI-Safeter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AI-Safeter/antigravity-plugin-manager/issues"
  },
  "homepage": "https://github.com/AI-Safeter/antigravity-plugin-manager#readme",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^4.1.2",
    "fs-extra": "^11.3.5",
    "fuse.js": "^7.3.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  },
  "files": [
    "src/**/*.js",
    "!src/**/*.test.js",
    "plugins",
    "scripts/create-skill.js",
    "scripts/update-registry.js",
    "scripts/validate-plugin.js",
    "registry.json",
    "sources.json",
    "curated-skills.json",
    "categories.json",
    "README.md",
    "LICENSE",
    "setup.sh"
  ]
}
